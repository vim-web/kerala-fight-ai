# ==============================================================================
# Kerala Sparring AI - Environment Variables
# ==============================================================================

# 1. Cloud Model (Recommended: Best Malayalam & Manglish performance, free tier)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Default backend: "gemini" (Cloud, fast & speaks Malayalam well) or "ollama" (Local offline)
PROVIDER=gemini

# 2. Local Model (Optional fallback for offline use)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_PREDICT=60

# 3. Security (Optional Passcode for local Wi-Fi / Phone network access)
# If set, devices opening the app from your Wi-Fi will be asked for this passcode
APP_PASSCODE=1234

# 4. Network Server Bindings
# Use 0.0.0.0 so phones on the same Wi-Fi network can connect to your laptop's IP
HOST=0.0.0.0
PORT=8000

